#!/bin/bash

# Function to determine the OS type
detect_os() {
  # Check for the presence of specific files to identify the OS
  if [ -f /etc/arch-release ]; then
    echo "arch"
  elif [ -f /etc/lsb-release ] && grep -q "Ubuntu" /etc/lsb-release; then
    echo "ubuntu"
  else
    echo "unknown"
  fi
}

# Function to install WezTerm on Arch Linux
install_wezterm() {
  if [ "$(detect_os)" = "arch" ]; then
    echo "Installing WezTerm on Arch Linux..."
    # Install WezTerm using paru
    paru -Sy --noconfirm wezterm
  else
    echo "This script currently supports WezTerm installation on Arch Linux only."
  fi
}

# Function to install Neovim
install_neovim() {
  if [ "$(detect_os)" = "arch" ]; then
    echo "Installing Neovim on Arch Linux..."
    # Install Neovim using paru
    paru -Sy --noconfirm neovim
  elif [ "$(detect_os)" = "ubuntu" ]; then
    echo "Installing Neovim on Ubuntu..."
    # Update package lists and install Neovim on Ubuntu
    sudo apt update && sudo apt install -y neovim
  else
    echo "This script currently supports Neovim installation on Arch Linux and Ubuntu only."
  fi
}

# Function to check and install Fish if not installed, then set as the default shell
set_shell() {
  echo "Which shell would you like to make default? [zsh|fish|nushell]: "
  selected_shell="$1"

  if [ -z "$selected_shell" ]; then
    echo "No shell manually selected, hence going with fish:"
    selected_shell="fish"
  fi

  # Normalize input
  selected_shell=$(echo "$selected_shell" | tr '[:upper:]' '[:lower:]')

  # Detect OS Step
  os=$(detect_os)

  case "$selected_shell" in
  fish)
    if ! command -v fish &>/dev/null; then
      echo "Fish shell is not installed. Installing Fish..."
      if [ "$os" = "arch" ]; then
        paru -Sy --noconfirm fish
      elif [ "$os" = "ubuntu" ]; then
        sudo apt update && sudo apt install -y fish
      else
        echo "Unsupported OS. Please install Fish manually."
        return 1
      fi
    fi
    chsh -s "$(command -v fish)"
    ;;

  zsh)
    if ! command -v zsh &>/dev/null; then
      echo "Zsh is not installed. Installing Zsh..."
      if [ "$os" = "arch" ]; then
        paru -Sy --noconfirm zsh
      elif [ "$os" = "ubuntu" ]; then
        sudo apt update && sudo apt install -y zsh
      else
        echo "Unsupported OS. Please install Zsh manually."
        return 1
      fi
    fi
    chsh -s "$(command -v zsh)"
    ;;

  nushell)
    if ! command -v nu &>/dev/null; then
      echo "Nushell is not installed. Installing Nushell..."
      if [ "$os" = "arch" ]; then
        paru -Sy --noconfirm nushell
      elif [ "$os" = "ubuntu" ]; then
        sudo apt update && sudo apt install -y nushell
      else
        echo "Unsupported OS. Please install Nushell manually."
        return 1
      fi
    fi
    chsh -s "$(command -v nu)"
    ;;

  *)
    echo "Unsupported shell: $selected_shell"
    echo "Supported options are: zsh, fish, nushell"
    return 1
    ;;
  esac

  echo "$selected_shell has been set as your default shell."
}

# Function to install fzf and input-remapper
install_fzf_and_input_remapper() {
  if [ "$(detect_os)" = "arch" ]; then
    echo "Installing fzf and input-remapper on Arch Linux..."
    # Install fzf using paru
    paru -Sy --noconfirm fzf
    # Install input-remapper using paru
    paru -Sy --noconfirm input-remapper
  elif [ "$(detect_os)" = "ubuntu" ]; then
    echo "Installing fzf and input-remapper on Ubuntu..."
    # Update package lists and install fzf on Ubuntu
    sudo apt update && sudo apt install -y fzf
    echo "Installing input-remapper..."
    # Add the PPA and install input-remapper
    sudo add-apt-repository ppa:justinmahar/input-remapper -y
    sudo apt update && sudo apt install -y input-remapper
  else
    echo "This script currently supports fzf and input-remapper installation on Arch Linux and Ubuntu only."
  fi
}

# Function to install paru on Arch Linux
install_paru() {
  if [ "$(detect_os)" = "arch" ]; then
    # Check if paru is already installed
    if ! command -v paru &>/dev/null; then
      echo "Installing paru (AUR helper) on Arch Linux..."
      # Install necessary tools for building AUR packages
      sudo pacman -Sy --noconfirm --needed base-devel git
      # Check if the directory for cloning already exists
      if [ -d "$HOME/paru" ]; then
        echo "Directory $HOME/paru already exists. Skipping clone."
      else
        # Clone the paru repository
        git clone https://aur.archlinux.org/paru.git "$HOME/paru"
      fi
      # Navigate to the directory and build the package
      cd "$HOME/paru" || exit
      makepkg -si --noconfirm
      cd - || exit
      # Remove the cloned directory after installation
      rm -rf "$HOME/paru"
    else
      echo "paru is already installed."
    fi
  else
    echo "paru installation is only supported on Arch Linux."
  fi
}

install_starship() {
  echo "Installing Starship"
  if [ "$(detect_os)" = "arch" ]; then
    echo "Installing starship on linux..."
    curl -sS https://starship.rs/install.sh | sh
  elif [ "$(detect_os)" = "ubuntu" ]; then
    echo "Installing starship on linux..."
    curl -sS https://starship.rs/install.sh | sh
  else
    echo "This script currently supports starship installation on Linux-Based Distros only."
  fi
}

# Run the installations
install_paru
set_shell
install_starship
install_wezterm
install_neovim
install_fzf_and_input_remapper
